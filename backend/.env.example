APP_NAME=CyberDesk API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./cyberdesk.db
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Clerk (Phase 2). Get these from your Clerk Dashboard -> API keys.
# CLERK_SECRET_KEY is a backend-only secret — never expose it to the
# frontend and never commit a real value here.
CLERK_SECRET_KEY=
# Optional but recommended: the PEM public key from the Dashboard's
# "Show JWT public key" panel, with real newlines replaced by \n. Enables
# fast local token verification without a network call per request. If
# left blank, the backend falls back to Clerk's networked JWKS endpoint.
CLERK_JWT_KEY=
